# 白名单构建上下文：镜像只消费 dist/releases/ 中的发版产物，源码与 node_modules 不进入上下文。
# Allow-list build context: images only consume release artifacts in dist/releases/;
# source trees and node_modules never enter the context.
*
!.github/docker/stage-release-artifacts.sh
!dist/releases/stx-linux-amd64
!dist/releases/stx-linux-arm64
!dist/releases/stx-agent-linux-amd64
!dist/releases/stx-agent-linux-arm64
!dist/releases/stx-java-proxy-v2.jar
!dist/releases/stx-java-proxy-v3.jar
!config.example.yaml
!scripts/stx-java-proxy.sh
!dist/releases/frontend-standalone-linux-amd64.tar.gz
!dist/releases/frontend-standalone-linux-arm64.tar.gz
!install/bin/start.sh
!install/bin/stop.sh
!install/bin/status.sh
!install/bin/lib/observability.sh
!.github/docker/all-in-one-entrypoint.sh
