# 镜像仓库前缀：海外默认 GHCR；中国华为云改为 swr.cn-east-3.myhuaweicloud.com/stx
# Image registry prefix: GHCR by default; for China Huawei SWR use swr.cn-east-3.myhuaweicloud.com/stx
STX_IMAGE_REGISTRY=ghcr.io/leonyoah
STX_IMAGE_TAG=latest
# 每个 Compose 服务注入的容器时区（IANA）。不改变库内 UTC 存储与 app.display_timezone。
# Timezone injected into every Compose service (IANA). Does not change UTC storage or app.display_timezone.
TZ=Asia/Shanghai
# MySQL DATETIME→UTC 一次性迁移的源时区。旧 Compose 控制面是 UTC，不要改成与 TZ 相同，除非确认库内仍是上海墙钟。
# Source zone for the one-shot MySQL DATETIME→UTC migration. Old Compose control planes were UTC; do not match TZ unless DATETIME values are still Shanghai wall clocks.
STX_DATABASE_LEGACY_TIMEZONE=UTC
# 数据库密码与库名配置
# Database credentials
MYSQL_ROOT_PASSWORD=stxroot
MYSQL_DATABASE=stx
MYSQL_USER=stx
MYSQL_PASSWORD=stx
POSTGRES_DB=stx
POSTGRES_USER=stx
POSTGRES_PASSWORD=stx

# 可选：自定义基础镜像（默认使用 Docker Hub 官方镜像）
# Optional: override base images (defaults to official Docker Hub images)
# MYSQL_IMAGE=mysql:8.4
# POSTGRES_IMAGE=postgres:16-alpine
