FRONTEND_BASE_URL=http://localhost:3000
# 前端服务端转发 /api 的控制面地址。Docker Compose 默认 http://stx-backend:17800，不必再配。
# Backend origin for the frontend /api proxy. Docker Compose defaults to http://stx-backend:17800.
BACKEND_BASE_URL=http://127.0.0.1:17800
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=YOUR_NEXT_PUBLIC_HCAPTCHA_SITE_KEY
HCAPTCHA_SECRET_KEY=YOUR_HCAPTCHA_SECRET_KEY
