<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Parent 固定 2.3.13，仅复用插件管理与公共属性；SeaTunnel 编译依赖版本由 seatunnel.version 控制。
      Parent stays on 2.3.13 for pluginManagement; compile-time SeaTunnel deps follow seatunnel.version.
      3.0 shade 模块坐标/版本与 2.3 不同，放在 epoch profile 内分别声明。
      3.0 shade module coordinates/versions differ from 2.3 and are declared per epoch profile.
    -->
    <parent>
        <groupId>org.apache.seatunnel</groupId>
        <artifactId>seatunnel</artifactId>
        <version>2.3.13</version>
        <relativePath />
    </parent>

    <groupId>io.github.leonyoah.stx</groupId>
    <artifactId>stx-java-proxy</artifactId>
    <packaging>jar</packaging>
    <name>STX : Java Proxy</name>

    <properties>
        <!-- 默认编译对齐 2.3.x；epoch-v3 profile 会覆盖为 3.0.0。 / Default compile line is 2.3.x; epoch-v3 overrides to 3.0.0. -->
        <seatunnel.version>2.3.13</seatunnel.version>
        <proxy.epoch>v2</proxy.epoch>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-api</artifactId>
            <version>${seatunnel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-core-starter</artifactId>
            <version>${seatunnel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>seatunnel-engine-core</artifactId>
            <version>${seatunnel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>checkpoint-storage-api</artifactId>
            <version>${seatunnel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>imap-storage-api</artifactId>
            <version>${seatunnel.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit5.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>checkpoint-storage-hdfs</artifactId>
            <version>${seatunnel.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.seatunnel</groupId>
            <artifactId>imap-storage-file</artifactId>
            <version>${seatunnel.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 代际标签命名：同一套源码分别产出 stx-java-proxy-v2.jar / stx-java-proxy-v3.jar。 -->
        <!-- Epoch-based jar name: one source tree produces stx-java-proxy-v2.jar / stx-java-proxy-v3.jar. -->
        <finalName>stx-java-proxy-${proxy.epoch}</finalName>
    </build>

    <profiles>
        <!-- 默认激活 v2；打 v3 时脚本必须使用 -Pepoch-v3,!epoch-v2。 -->
        <!-- epoch-v2 is active by default; v3 builds must use -Pepoch-v3,!epoch-v2. -->
        <profile>
            <id>epoch-v2</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <seatunnel.version>2.3.13</seatunnel.version>
                <proxy.epoch>v2</proxy.epoch>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-jackson</artifactId>
                    <version>${seatunnel.version}</version>
                    <classifier>optional</classifier>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-commons-lang3</artifactId>
                    <version>${seatunnel.version}</version>
                    <classifier>optional</classifier>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-guava</artifactId>
                    <version>${seatunnel.version}</version>
                    <classifier>optional</classifier>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-hadoop3-3.1.4-uber</artifactId>
                    <version>${seatunnel.version}</version>
                    <classifier>optional</classifier>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>epoch-v3</id>
            <properties>
                <seatunnel.version>3.0.0</seatunnel.version>
                <proxy.epoch>v3</proxy.epoch>
            </properties>
            <dependencies>
                <!-- 3.0 shade 模块使用独立版本号（上游依赖版本-3.0.0）。 -->
                <!-- 3.0 shade modules use independent versions (upstream-dep-version-3.0.0). -->
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-shade-jackson</artifactId>
                    <version>2.15.4-3.0.0</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-shade-commons-lang3</artifactId>
                    <version>3.18.0-3.0.0</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-shade-guava</artifactId>
                    <version>27.0-jre-3.0.0</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.seatunnel</groupId>
                    <artifactId>seatunnel-shade-hadoop3-uber</artifactId>
                    <version>3.1.4-3.0.0</version>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>standalone-bin</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <version>${maven-shade-plugin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>shade</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <createDependencyReducedPom>false</createDependencyReducedPom>
                                    <shadedArtifactAttached>true</shadedArtifactAttached>
                                    <shadedClassifierName>bin</shadedClassifierName>
                                    <artifactSet>
                                        <excludes>
                                            <exclude>org.apache.seatunnel:checkpoint-storage-hdfs</exclude>
                                            <exclude>org.apache.seatunnel:imap-storage-file</exclude>
                                            <exclude>org.apache.seatunnel:seatunnel-hadoop3-3.1.4-uber</exclude>
                                            <exclude>org.apache.seatunnel:seatunnel-shade-hadoop3-uber</exclude>
                                            <exclude>org.apache.seatunnel:seatunnel-hazelcast-shade</exclude>
                                            <exclude>org.apache.seatunnel:seatunnel-shade-hazelcast</exclude>
                                        </excludes>
                                    </artifactSet>
                                    <transformers>
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                        <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                            <mainClass>io.github.leonyoah.stx.proxy.StxJavaProxyApplication</mainClass>
                                        </transformer>
                                    </transformers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
