# 镜像仓库前缀：海外默认 GHCR；中国华为云改为 swr.cn-east-3.myhuaweicloud.com/stx
# Image registry prefix: GHCR by default; for China Huawei SWR use swr.cn-east-3.myhuaweicloud.com/stx
STX_IMAGE_REGISTRY=ghcr.io/leonyoah
STX_IMAGE_TAG=latest
STX_BACKEND_PUBLIC_URL=http://127.0.0.1:17800
# 数据库密码与库名配置
# Database credentials
MYSQL_ROOT_PASSWORD=stxroot
MYSQL_DATABASE=stx
MYSQL_USER=stx
MYSQL_PASSWORD=stx
POSTGRES_DB=stx
POSTGRES_USER=stx
POSTGRES_PASSWORD=stx

# 可选：自定义基础镜像（默认使用 Docker Hub 官方镜像）
# Optional: override base images (defaults to official Docker Hub images)
# MYSQL_IMAGE=mysql:8.4
# POSTGRES_IMAGE=postgres:16-alpine
# PROMETHEUS_IMAGE=prom/prometheus:v3.9.1
# ALERTMANAGER_IMAGE=prom/alertmanager:v0.31.1
# GRAFANA_IMAGE=grafana/grafana:12.3.3
