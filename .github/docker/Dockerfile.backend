# ------------------------------------------------------------------------------
# STX 后端镜像：只消费 dist/releases/ 中的发版产物，不在 Docker 内编译 Go / Java。
# STX backend image: consumes release artifacts from dist/releases/ only; no Go / Java compilation in Docker.
#
# 先打包产物再构建 / Package first, then build:
#   install/package-release.sh --arch all --layout split --build-frontend
#   docker buildx build -f .github/docker/Dockerfile.backend --platform linux/amd64 .
# 或 / or: make docker-images
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 阶段 1: 校验并暂存发版产物（stx、双架构 agent、java-proxy v2/v3），缺失即失败并列出文件名
# Stage 1: Verify and stage release artifacts (stx, dual-arch agent, java-proxy v2/v3); fail listing missing files
# ------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS artifacts

# BuildKit 自动注入目标架构，勿赋予写死默认值
# BuildKit injects the target architecture automatically; do not hardcode a default
ARG TARGETARCH

RUN --mount=type=bind,target=/ctx \
    sh /ctx/.github/docker/stage-release-artifacts.sh /ctx/dist/releases /out "${TARGETARCH}" backend

# ------------------------------------------------------------------------------
# 阶段 2: 运行环境
# Stage 2: Runtime environment
# ------------------------------------------------------------------------------
FROM debian:bookworm-slim

ARG APP_VERSION
ARG GIT_COMMIT

LABEL org.opencontainers.image.source="https://github.com/LeonYoah/stx" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tzdata openssl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/stx

COPY --from=artifacts /out/stx /opt/stx/stx
COPY config.example.yaml /opt/stx/config.yaml

# 拷贝启动脚本与 entrypoint
# Copy launcher script and entrypoint
COPY scripts/stx-java-proxy.sh /opt/stx/scripts/stx-java-proxy.sh
COPY .github/docker/backend-entrypoint.sh /opt/stx/bin/backend-entrypoint.sh

# 预置分发资产到 lib 目录及 default-lib 种子目录（防宿主机空卷挂载覆盖）
# Stage distribution assets in lib and default-lib seed directory (prevent host empty bind mount masking)
COPY --from=artifacts /out/lib /opt/stx/lib
COPY --from=artifacts /out/lib /opt/stx/default-lib

RUN mkdir -p /opt/stx/scripts /opt/stx/bin && \
    chmod +x /opt/stx/stx /opt/stx/scripts/*.sh /opt/stx/bin/*.sh /opt/stx/lib/agent/* /opt/stx/default-lib/agent/*

EXPOSE 17800 17890

# 使用带种子保护的 entrypoint 启动
# Start with entrypoint providing seed protection
ENTRYPOINT ["/opt/stx/bin/backend-entrypoint.sh"]
CMD ["server"]
