# ------------------------------------------------------------------------------
# STX all-in-one 镜像：只消费 dist/releases/ 中的发版产物，不在 Docker 内编译 Go / Java / 前端。
# STX all-in-one image: consumes release artifacts from dist/releases/ only; no Go / Java / frontend build in Docker.
#
# 先打包产物再构建 / Package first, then build:
#   install/package-release.sh --arch all --layout split --build-frontend
#   docker buildx build -f .github/docker/Dockerfile.all-in-one --platform linux/amd64 .
# 或 / or: make docker-images
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 阶段 1: 校验并暂存全部发版产物（stx、双架构 agent、java-proxy v2/v3、前端 standalone），缺失即失败并列出文件名
# Stage 1: Verify and stage all release artifacts (stx, dual-arch agent, java-proxy v2/v3, frontend standalone)
# ------------------------------------------------------------------------------
FROM --platform=$BUILDPLATFORM debian:bookworm-slim AS artifacts

# BuildKit 自动注入目标架构，勿赋予写死默认值
# BuildKit injects the target architecture automatically; do not hardcode a default
ARG TARGETARCH

RUN --mount=type=bind,target=/ctx \
    sh /ctx/.github/docker/stage-release-artifacts.sh /ctx/dist/releases /out "${TARGETARCH}" backend frontend

# ------------------------------------------------------------------------------
# 阶段 2: 运行环境
# Stage 2: Runtime environment
# ------------------------------------------------------------------------------
FROM node:22.23.4-bookworm-slim

ARG APP_VERSION
ARG GIT_COMMIT

LABEL org.opencontainers.image.source="https://github.com/LeonYoah/stx" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tzdata openssl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/stx

COPY --from=artifacts /out/stx /opt/stx/stx
COPY --from=artifacts /out/frontend /opt/stx/frontend
COPY config.example.yaml /opt/stx/config.yaml
COPY install/bin/start.sh /opt/stx/bin/start.sh
COPY install/bin/stop.sh /opt/stx/bin/stop.sh
COPY install/bin/status.sh /opt/stx/bin/status.sh
COPY install/bin/lib/observability.sh /opt/stx/bin/lib/observability.sh
COPY .github/docker/all-in-one-entrypoint.sh /opt/stx/bin/all-in-one-entrypoint.sh

# 拷贝启动脚本与分发资产（lib 与 default-lib 种子目录）
# Copy launcher script and distribution assets (lib and default-lib seed directory)
COPY scripts/stx-java-proxy.sh /opt/stx/scripts/stx-java-proxy.sh
COPY --from=artifacts /out/lib /opt/stx/lib
COPY --from=artifacts /out/lib /opt/stx/default-lib

RUN mkdir -p /opt/stx/runtime/node/bin /opt/stx/bin/lib /opt/stx/logs /opt/stx/run /opt/stx/scripts && \
    ln -sf /usr/local/bin/node /opt/stx/runtime/node/bin/node && \
    chmod +x /opt/stx/stx /opt/stx/bin/*.sh /opt/stx/scripts/*.sh /opt/stx/lib/agent/* /opt/stx/default-lib/agent/*

EXPOSE 17880 17800 17890

ENTRYPOINT ["/opt/stx/bin/all-in-one-entrypoint.sh"]
