# 中国华为云 SWR 示例：复制为 .env 后按需改密码与 tag。
# China Huawei SWR example: copy to .env, then adjust passwords and tag.

# STX 自身应用镜像（华为云 SWR，组织 stx）
# STX application images (Huawei Cloud SWR, namespace stx)
STX_IMAGE_REGISTRY=swr.cn-east-3.myhuaweicloud.com/stx
STX_IMAGE_TAG=latest
STX_BACKEND_PUBLIC_URL=http://127.0.0.1:17800

# 国内镜像加速：基础数据库与可观测性三件套（华为云 SWR 转储加速，国内直连极速拉取）
# Domestic mirror acceleration for database & observability stack (Huawei SWR mirror, fast domestic pull)
MYSQL_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/mysql:8.0
POSTGRES_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/postgres:16-alpine
PROMETHEUS_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/prom/prometheus:v3.9.1
ALERTMANAGER_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/prom/alertmanager:latest
GRAFANA_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/grafana/grafana:latest

# 数据库密码与库名配置
# Database credentials
MYSQL_ROOT_PASSWORD=stxroot
MYSQL_DATABASE=stx
MYSQL_USER=stx
MYSQL_PASSWORD=stx
POSTGRES_DB=stx
POSTGRES_USER=stx
POSTGRES_PASSWORD=stx
