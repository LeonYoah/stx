FROM golang:1.24-bookworm AS backend-builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG TARGETOS=linux
ARG TARGETARCH=amd64
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -o /out/stx .

FROM node:22-bookworm AS frontend-builder

WORKDIR /src/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && corepack prepare pnpm@10.10.0 --activate
RUN pnpm install --frozen-lockfile

COPY frontend/ .
RUN pnpm run pack:standalone

FROM node:22-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tzdata openssl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/stx

COPY --from=backend-builder /out/stx /opt/stx/stx
COPY --from=frontend-builder /src/frontend/dist-standalone /opt/stx/frontend
COPY config.example.yaml /opt/stx/config.yaml
COPY support-files/release/start.sh /opt/stx/bin/start.sh
COPY support-files/release/stop.sh /opt/stx/bin/stop.sh
COPY support-files/release/status.sh /opt/stx/bin/status.sh
COPY .github/docker/all-in-one-entrypoint.sh /opt/stx/bin/all-in-one-entrypoint.sh

RUN mkdir -p /opt/stx/runtime/node/bin /opt/stx/logs /opt/stx/run && \
    ln -sf /usr/local/bin/node /opt/stx/runtime/node/bin/node && \
    chmod +x /opt/stx/stx /opt/stx/bin/*.sh

EXPOSE 80 8000 9000

ENTRYPOINT ["/opt/stx/bin/all-in-one-entrypoint.sh"]
