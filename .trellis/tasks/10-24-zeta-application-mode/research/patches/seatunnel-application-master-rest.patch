+    @Test
+    void keepsEngineHttpSettingsOnlyForTheMasterWhenRestIsRequested() {
+        SeaTunnelConfig master = new SeaTunnelConfig();
+        master.getEngineConfig().getHttpConfig().setEnabled(false);
+        master.getEngineConfig().getHttpConfig().setEnableHttps(true);
+        master.getEngineConfig().getHttpConfig().setEnableDynamicPort(true);
+        master.getEngineConfig().getHttpConfig().setEnableBasicAuth(true);
+        master.getEngineConfig().getHttpConfig().setContextPath("/seatunnel");
+        SeatunnelApplicationConfig.configure(master, "unique-application", null, 2, 18080);
+        HttpConfig http = master.getEngineConfig().getHttpConfig();
+        assertTrue(http.isEnabled());
+        assertFalse(http.isEnableHttps());
+        assertFalse(http.isEnableDynamicPort());
+        assertEquals(18080, http.getPort());
+        assertTrue(http.isEnableBasicAuth());
+        assertEquals("/seatunnel", http.getContextPath());
+
+        SeaTunnelConfig worker = new SeaTunnelConfig();
+        worker.getEngineConfig().getHttpConfig().setEnabled(true);
+        SeatunnelApplicationConfig.configure(worker, "unique-application", "master:5801", 2, 18080);
+        assertFalse(worker.getEngineConfig().getHttpConfig().isEnabled());
+    }
 }
