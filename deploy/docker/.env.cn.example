# 中国华为云 SWR 示例：复制为 .env 后按需改密码与 tag。
# China Huawei SWR example: copy to .env, then adjust passwords and tag.
STX_IMAGE_REGISTRY=swr.cn-east-3.myhuaweicloud.com/stx
STX_IMAGE_TAG=latest
STX_BACKEND_PUBLIC_URL=http://127.0.0.1:17800
MYSQL_ROOT_PASSWORD=stxroot
MYSQL_DATABASE=stx
MYSQL_USER=stx
MYSQL_PASSWORD=stx
POSTGRES_DB=stx
POSTGRES_USER=stx
POSTGRES_PASSWORD=stx
