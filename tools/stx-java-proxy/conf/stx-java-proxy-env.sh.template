# ==============================================================================
# stx-java-proxy Environment & JVM Configuration
# ==============================================================================
# By default, stx-java-proxy enforces a 512MB heap limit: -Xms64m -Xmx512m.
#
# You can customize proxy JVM memory options here.
# To activate, copy this template as stx-java-proxy-env.sh:
#   cp conf/stx-java-proxy-env.sh.template conf/stx-java-proxy-env.sh
#
# Supported configuration locations:
#   1. ${STX_JAVA_PROXY_CONF_DIR}/stx-java-proxy-env.sh
#   2. ${PROXY_HOME}/conf/stx-java-proxy-env.sh
#   3. ${SEATUNNEL_HOME}/config/stx-java-proxy-env.sh
# ==============================================================================

# Custom proxy JVM memory options (overrides the default 512MB limit)
# Example: 1GB max heap with G1GC
# export STX_JAVA_PROXY_JVM_OPTS="-Xms128m -Xmx1024m -XX:+UseG1GC"

# Alternatively, set individual system properties:
# export STX_JAVA_PROXY_JVM_OPTS="-Dstx.java.proxy.xmx=1024m"
